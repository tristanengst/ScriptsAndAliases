+/*
+ * Workstation SLURM patch: users are the same user by name, not by uid (see
+ * auth_munge.c). A credential's identity was filled in by slurmctld, with the
+ * uid, gid and groups the user has on slurmctld's machine; replace them with
+ * those the same user name has here. A name unknown here gets uid nobody, which
+ * launching refuses.
+ */
+static void _localize_identity(slurm_cred_arg_t *arg)
+{
+	uid_t uid;
+	identity_t *id;
+
+	if (!arg || !arg->id || !arg->id->pw_name)
+		return;
+	if (uid_from_string(arg->id->pw_name, &uid) != SLURM_SUCCESS) {
+		error("%s: no local user %s", __func__, arg->id->pw_name);
+		arg->uid = SLURM_AUTH_NOBODY;
+		arg->gid = SLURM_AUTH_NOBODY;
+		return;
+	}
+	if ((uid == arg->uid) && (arg->id->uid == uid))
+		return;
+	if (!(id = fetch_identity(uid, gid_from_uid(uid), false))) {
+		error("%s: fetch_identity(%u) failed", __func__, uid);
+		arg->uid = SLURM_AUTH_NOBODY;
+		arg->gid = SLURM_AUTH_NOBODY;
+		return;
+	}
+	debug("%s: user %s is uid %u here, not %u", __func__, id->pw_name, uid,
+	      arg->uid);
+	FREE_NULL_IDENTITY(arg->id);
+	arg->id = id;
+	arg->uid = id->uid;
+	arg->gid = id->gid;
+}
+
 extern slurm_cred_t *slurm_cred_unpack(buf_t *buffer, uint16_t protocol_version)
 {
-	return (*(ops.cred_unpack))(buffer, protocol_version);
+	slurm_cred_t *cred = (*(ops.cred_unpack))(buffer, protocol_version);
+
+	if (cred)
+		_localize_identity(cred->arg);
+	return cred;
 }
 
 extern slurm_cred_t *slurm_cred_alloc(bool alloc_arg)
